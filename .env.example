FLASK_APP=app:create_app
FLASK_DEBUG=0
APP_ENV=development
SECRET_KEY=local-development-only
DATABASE_URL=postgresql+psycopg://booking:booking_dev_only@localhost:5433/booking_platform
TEST_DATABASE_URL=postgresql+psycopg://booking:booking_dev_only@localhost:5433/booking_platform_test
MIGRATION_DATABASE_URL=postgresql+psycopg://booking:booking_dev_only@localhost:5433/booking_platform_migration_test
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=redis://localhost:6379/1
RATELIMIT_KEY_PREFIX=booking-platform:
TEST_REDIS_URL=redis://localhost:6379/15
POSTGRES_DB=booking_platform
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking_dev_only
EMAIL_BACKEND=console
SESSION_COOKIE_SECURE=false
SERVER_SESSION_TTL_SECONDS=86400
WEB_WORKERS=3
PORT=5000
# Optional scripts/run_e2e.py settings; normally keep the defaults.
E2E_PORT=5001
E2E_SMOKE_ONLY=false
E2E_LAYOUT_ONLY=false
E2E_BASE_URL=http://127.0.0.1:5001
E2E_EMAIL_LOG=.artifacts/e2e/server.log
AUTH_LAYOUT_SCREENSHOT_DIR=.artifacts/e2e/auth-layout
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=INFO
SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Choose STARTTLS (usually port 587) or implicit SSL (usually port 465).
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
# Optional development inbox: replace the EMAIL_BACKEND and SMTP values above with these
# (do not append duplicate keys). Start it with `docker compose --profile dev up`.
# EMAIL_BACKEND=smtp
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=booking@localhost
# SMTP_TLS_MODE=none
# Optional cheaper deployment mode; migrations use a PostgreSQL advisory lock.
MIGRATE_ON_STARTUP=false
SEED_DEMO_ON_STARTUP=false
# Auth rate limits. Login defaults to 5/minute per IP+email and 30/hour per IP.
AUTH_REGISTER_RATE_LIMIT=20 per hour
AUTH_LOGIN_EMAIL_RATE_LIMIT=5 per minute
AUTH_LOGIN_IP_RATE_LIMIT=30 per hour
AUTH_FORGOT_EMAIL_RATE_LIMIT=5 per hour
AUTH_FORGOT_IP_RATE_LIMIT=30 per hour
AUTH_RESET_TOKEN_RATE_LIMIT=5 per hour
AUTH_RESET_IP_RATE_LIMIT=30 per hour
AUTH_RESEND_VERIFICATION_EMAIL_RATE_LIMIT=3 per hour
AUTH_RESEND_VERIFICATION_IP_RATE_LIMIT=30 per hour
AUTH_RESEND_VERIFICATION_COOLDOWN_SECONDS=60
# Availability: minimum notice defaults to 2 hours, maximum advance to 60 days.
AVAILABILITY_MINIMUM_NOTICE_MINUTES=120
AVAILABILITY_MAXIMUM_ADVANCE_DAYS=60
PUBLIC_AVAILABILITY_RATE_LIMIT=60 per minute
# Booking flow: unpaid deposits hold a slot for 15 minutes; users may hold 3 at once.
HOLD_MINUTES=15
MAX_PENDING_HOLDS_PER_USER=3
BOOKING_CREATE_RATE_LIMIT=10 per minute
# Background notification queue: one worker and one scheduler by default.
RQ_QUEUE_NAME=default
NOTIFICATION_BATCH_SIZE=100
SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_IN_PROGRESS_TIMEOUT_SECONDS=300
# Seconds between notification retries (four retries; five total attempts).
NOTIFICATION_RETRY_INTERVALS_SECONDS=60,300,900,900
BOOKING_MANAGE_BASE_URL=http://localhost:5000
# PayFast custom integration. Use sandbox credentials while testing.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_ITN_RATE_LIMIT=600 per minute
PAYFAST_VALIDATE_TIMEOUT_SECONDS=8
PAYMENT_HOLD_MINUTES=20
# Set to a publicly reachable HTTPS origin for ITNs (e.g. Cloudflare Tunnel/ngrok).
PUBLIC_BASE_URL=http://localhost:5000
# Exposed at GET /api/config so the frontend can label demo payments.
DEMO_MODE=false
# Local demo-only owner credentials; change before sharing a demo environment.
DEMO_OWNER_EMAIL=owner@fade-lab.demo
DEMO_OWNER_PASSWORD=DemoOnly-ChangeMe-2026!
DEMO_OWNER_NAME=Fade Lab Owner

